{
	"name": "svelte-attach-motion",
	"version": "0.0.2",
	"description": "Motion animations for Svelte 5 as attachments: animate, inView, scroll, hover and press, with reduced-motion support built in.",
	"license": "MIT",
	"author": "andasan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/andasan/svelte-attach-motion.git"
	},
	"homepage": "https://ds2l9pktw39ce.cloudfront.net",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./reveal.css": "./dist/reveal.css"
	},
	"peerDependencies": {
		"motion": "^13.0.0",
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"motion": "^13.4.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte5",
		"attachment",
		"attachments",
		"motion",
		"animation",
		"framer-motion",
		"scroll",
		"gesture",
		"reduced-motion"
	],
	"packageManager": "pnpm@12.6.0"
}
